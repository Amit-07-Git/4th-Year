"""Request/response models and shared formatting helpers."""
from __future__ import annotations

from datetime import datetime, timezone
from typing import Optional

from pydantic import BaseModel, Field, field_validator

STATUS_ONLINE = "ONLINE"
STATUS_OFFLINE = "OFFLINE"

# Letters/digits first, then letters/digits/dot/underscore/hyphen, max 64 chars.
DEVICE_ID_PATTERN = r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"


def iso_z(dt: datetime) -> str:
    """Format an aware datetime as ISO-8601 UTC with a 'Z' suffix."""
    return dt.astimezone(timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")


class DeviceRegistration(BaseModel):
    id: str = Field(..., pattern=DEVICE_ID_PATTERN, examples=["device-01"])
    name: Optional[str] = Field(None, max_length=100)

    @field_validator("name")
    @classmethod
    def _clean_name(cls, value: Optional[str]) -> Optional[str]:
        if value is None:
            return None
        value = value.strip()
        return value or None


class Heartbeat(BaseModel):
    timestamp: Optional[datetime] = None  # client-reported; defaults to server receive time
    status: str = Field(..., min_length=1, max_length=32)
    cpu_usage: Optional[float] = Field(None, ge=0, le=100)
    signal_strength: Optional[float] = Field(None, ge=-150, le=0)

    @field_validator("status")
    @classmethod
    def _clean_status(cls, value: str) -> str:
        value = value.strip()
        if not value:
            raise ValueError("status must not be blank")
        return value

    @field_validator("timestamp")
    @classmethod
    def _normalize_timestamp(cls, value: Optional[datetime]) -> Optional[datetime]:
        if value is None:
            return None
        if value.tzinfo is None:
            return value.replace(tzinfo=timezone.utc)  # naive timestamps are assumed UTC
        return value.astimezone(timezone.utc)


class DeviceResponse(BaseModel):
    id: str
    name: str
    status: str  # derived: ONLINE | OFFLINE
    last_heartbeat: Optional[str] = None  # client timestamp (or server receive time if omitted)
    last_seen: Optional[str] = None       # server receive time of the latest heartbeat
    seconds_since_last_heartbeat: Optional[float] = None
    heartbeat_count: int = 0
    last_reported_status: Optional[str] = None
    last_cpu_usage: Optional[float] = None
    last_signal_strength: Optional[float] = None


class SummaryResponse(BaseModel):
    total: int
    online: int
    offline: int
