import threading
from datetime import timedelta

import pytest

from fleet_monitor.schemas import Heartbeat
from fleet_monitor.store import DuplicateDeviceError, Store, UnknownDeviceError


def make_store(clock) -> Store:
    return Store(clock=clock, heartbeat_timeout_seconds=30)


def test_register_returns_snapshot(clock):
    store = make_store(clock)
    device = store.register("device-01", "Lab Device 01")
    assert device["id"] == "device-01"
    assert device["name"] == "Lab Device 01"
    assert device["status"] == "OFFLINE"  # no heartbeat yet
    assert device["heartbeat_count"] == 0
    assert device["last_heartbeat"] is None


def test_register_duplicate_rejected(clock):
    store = make_store(clock)
    store.register("device-01", "Lab Device 01")
    with pytest.raises(DuplicateDeviceError):
        store.register("device-01", "Another name")


def test_heartbeat_updates_latest_state(clock):
    store = make_store(clock)
    store.register("device-01", None)
    snapshot = store.record_heartbeat("device-01", Heartbeat(status="OK", cpu_usage=42.0))
    assert snapshot["status"] == "ONLINE"
    assert snapshot["heartbeat_count"] == 1
    assert snapshot["last_reported_status"] == "OK"
    assert snapshot["last_cpu_usage"] == 42.0

    clock.advance(5)
    snapshot = store.record_heartbeat("device-01", Heartbeat(status="WARNING", cpu_usage=88.0))
    assert snapshot["heartbeat_count"] == 2
    assert snapshot["last_reported_status"] == "WARNING"
    assert snapshot["last_cpu_usage"] == 88.0


def test_heartbeat_for_unknown_device_raises(clock):
    store = make_store(clock)
    with pytest.raises(UnknownDeviceError):
        store.record_heartbeat("ghost", Heartbeat(status="OK"))


def test_status_is_online_within_30_seconds(clock):
    store = make_store(clock)
    store.register("d1", None)
    store.record_heartbeat("d1", Heartbeat(status="OK"))
    clock.advance(29.999)
    assert store.get("d1")["status"] == "ONLINE"


def test_status_at_exactly_30_seconds_is_online(clock):
    # Requirement: ONLINE if a heartbeat arrived *within* the last 30 seconds.
    store = make_store(clock)
    store.register("d1", None)
    store.record_heartbeat("d1", Heartbeat(status="OK"))
    clock.advance(30)
    assert store.get("d1")["status"] == "ONLINE"


def test_status_is_offline_after_30_seconds(clock):
    store = make_store(clock)
    store.register("d1", None)
    store.record_heartbeat("d1", Heartbeat(status="OK"))
    clock.advance(30.001)
    assert store.get("d1")["status"] == "OFFLINE"


def test_never_seen_device_is_offline(clock):
    store = make_store(clock)
    store.register("d1", None)
    assert store.get("d1")["status"] == "OFFLINE"


def test_device_recovers_when_heartbeat_resumes(clock):
    store = make_store(clock)
    store.register("d1", None)
    store.record_heartbeat("d1", Heartbeat(status="OK"))
    clock.advance(61)
    assert store.get("d1")["status"] == "OFFLINE"
    store.record_heartbeat("d1", Heartbeat(status="OK"))
    assert store.get("d1")["status"] == "ONLINE"


def test_summary_counts_statuses(clock):
    store = make_store(clock)
    for i in range(1, 6):
        store.register(f"device-{i:02d}", None)
    for i in (1, 2, 3):
        store.record_heartbeat(f"device-{i:02d}", Heartbeat(status="OK"))
    assert store.summary() == {"total": 5, "online": 3, "offline": 2}
    clock.advance(31)
    assert store.summary() == {"total": 5, "online": 0, "offline": 5}


def test_list_devices_filters_by_status(clock):
    store = make_store(clock)
    store.register("a", None)
    store.register("b", None)
    store.record_heartbeat("a", Heartbeat(status="OK"))
    assert [d["id"] for d in store.list_devices("ONLINE")] == ["a"]
    assert [d["id"] for d in store.list_devices("OFFLINE")] == ["b"]
    assert len(store.list_devices()) == 2


def test_concurrent_heartbeats_are_counted_correctly():
    # Real clock: hammer the store from many threads to check the lock works.
    store = Store(heartbeat_timeout_seconds=30)
    store.register("d1", None)
    per_thread, threads = 200, []

    def worker():
        for _ in range(per_thread):
            store.record_heartbeat("d1", Heartbeat(status="OK"))

    for _ in range(8):
        threads.append(threading.Thread(target=worker))
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    assert store.get("d1")["heartbeat_count"] == 8 * per_thread
