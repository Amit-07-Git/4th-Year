#!/usr/bin/env python3
"""Simulate a small fleet of devices sending heartbeats to the fleet monitor.

Usage:
    python simulator/simulate.py                 # interactive mode
    python simulator/simulate.py --demo          # scripted stop/restart demo (~75s)
    python simulator/simulate.py --interval 2    # faster heartbeats

Interactive commands:
    stop device-03    stop sending heartbeats for a device (it will go OFFLINE)
    start device-03   resume sending heartbeats
    status            print the server's current view of the fleet
    quit              exit the simulator
"""

import argparse
import os
import random
import sys
import threading
import time
from datetime import datetime, timezone

import requests

FLEET = [
    ("device-01", "Lab Device 01"),
    ("device-02", "Lab Device 02"),
    ("device-03", "Lab Device 03"),
    ("device-04", "Lab Device 04"),
    ("device-05", "Lab Device 05"),
]


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


class SimulatedDevice(threading.Thread):
    """Sends a heartbeat every `interval` seconds until paused or stopped."""

    def __init__(self, api_url: str, device_id: str, display_name: str, interval: float):
        super().__init__(name=device_id, daemon=True)
        self.api_url = api_url
        self.device_id = device_id
        self.display_name = display_name
        self.interval = interval
        self._paused = threading.Event()
        self._stop = threading.Event()
        self._session = requests.Session()

    def pause(self) -> None:
        self._paused.set()

    def resume(self) -> None:
        self._paused.clear()

    @property
    def paused(self) -> bool:
        return self._paused.is_set()

    def stop(self) -> None:
        self._stop.set()

    def register(self) -> bool:
        try:
            response = self._session.post(
                f"{self.api_url}/devices",
                json={"id": self.device_id, "name": self.display_name},
                timeout=5,
            )
        except requests.RequestException as exc:
            print(f"[sim] register {self.device_id} failed: {exc}")
            return False
        if response.status_code in (201, 409):  # created, or already registered
            return True
        print(f"[sim] register {self.device_id} unexpected status {response.status_code}: {response.text}")
        return False

    def run(self) -> None:
        while not self._stop.is_set():
            if not self._paused.is_set():
                self._send_heartbeat()
            self._stop.wait(timeout=self.interval)

    def _send_heartbeat(self) -> None:
        payload = {
            "timestamp": utc_now_iso(),
            "status": "OK",
            "cpu_usage": round(random.uniform(5, 95), 1),
            "signal_strength": round(random.uniform(-100, -40)),
        }
        try:
            response = self._session.post(
                f"{self.api_url}/devices/{self.device_id}/heartbeat", json=payload, timeout=5
            )
            if response.status_code != 200:
                print(f"[sim] {self.device_id} heartbeat rejected: HTTP {response.status_code}")
        except requests.RequestException as exc:
            print(f"[sim] {self.device_id} heartbeat failed: {exc}")


def wait_for_api(api_url: str, timeout_seconds: int = 30) -> bool:
    print(f"[sim] waiting for API at {api_url} ...")
    deadline = time.time() + timeout_seconds
    while time.time() < deadline:
        try:
            requests.get(f"{api_url}/health", timeout=2)
            return True
        except requests.RequestException:
            time.sleep(1)
    return False


def print_fleet(api_url: str) -> None:
    try:
        devices = requests.get(f"{api_url}/devices", timeout=5).json()
    except requests.RequestException:
        print("[sim] could not fetch fleet status")
        return
    print(f"\n{'device':<12}{'status':<10}{'last_heartbeat':<28}{'hb#':>5}")
    for d in sorted(devices, key=lambda d: d["id"]):
        last = d["last_heartbeat"] or "-"
        print(f"{d['id']:<12}{d['status']:<10}{last:<28}{d['heartbeat_count']:>5}")
    print()


def run_interactive(fleet: dict, api_url: str) -> None:
    print("\nCommands: stop <id> | start <id> | status | quit\n")
    while True:
        try:
            line = input("sim> ").strip()
        except (EOFError, KeyboardInterrupt):
            break
        if not line:
            continue
        parts = line.split()
        if parts[0] == "quit":
            break
        if parts[0] == "status":
            print_fleet(api_url)
        elif parts[0] in {"stop", "start"} and len(parts) == 2:
            device = fleet.get(parts[1])
            if device is None:
                print(f"unknown device '{parts[1]}' (try: {', '.join(fleet)})")
            elif parts[0] == "stop":
                device.pause()
                print(f"{device.device_id} paused -> it will show OFFLINE after the 30s timeout")
            else:
                device.resume()
                print(f"{device.device_id} resumed -> back ONLINE at the next heartbeat")
        else:
            print("usage: stop <id> | start <id> | status | quit")


def run_demo(fleet: dict, api_url: str) -> None:
    print("\n=== demo: fleet is running, all devices should be ONLINE ===")
    time.sleep(32)
    print_fleet(api_url)

    print("=== demo: pausing device-03 (heartbeats stop) ===")
    fleet["device-03"].pause()
    for elapsed in range(5, 40, 5):
        time.sleep(5)
        summary = requests.get(f"{api_url}/summary", timeout=5).json()
        print(f"t+{elapsed:>2}s summary: {summary}")
    print_fleet(api_url)  # device-03 is now OFFLINE

    print("=== demo: resuming device-03 ===")
    fleet["device-03"].resume()
    time.sleep(6)
    print_fleet(api_url)  # device-03 is ONLINE again
    print("=== demo finished (Ctrl+C to exit) ===")


def main() -> None:
    parser = argparse.ArgumentParser(description="Device fleet simulator")
    parser.add_argument("--api-url", default=os.environ.get("API_URL", "http://127.0.0.1:8000"))
    parser.add_argument("--interval", type=float, default=5.0, help="seconds between heartbeats (default: 5)")
    parser.add_argument("--demo", action="store_true", help="run a scripted stop/restart demo")
    args = parser.parse_args()

    if not wait_for_api(args.api_url):
        print("API did not become available in time", file=sys.stderr)
        sys.exit(1)

    fleet: dict = {}
    for device_id, display_name in FLEET:
        device = SimulatedDevice(args.api_url, device_id, display_name, args.interval)
        for _ in range(5):
            if device.register():
                break
            time.sleep(1)
        else:
            print(f"giving up on {device_id}", file=sys.stderr)
            sys.exit(1)
        device.start()
        fleet[device_id] = device
    print(f"[sim] {len(fleet)} devices sending heartbeats every {args.interval}s")

    try:
        if args.demo:
            run_demo(fleet, args.api_url)
        else:
            run_interactive(fleet, args.api_url)
    except KeyboardInterrupt:
        pass
    finally:
        for device in fleet.values():
            device.stop()
    print("[sim] done.")


if __name__ == "__main__":
    main()
