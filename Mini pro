"""FastAPI application: routes, error mapping, app factory."""
from __future__ import annotations

from typing import Optional

from fastapi import APIRouter, Depends, FastAPI, Query, Request
from fastapi.responses import JSONResponse

from .config import Config
from .schemas import DeviceRegistration, DeviceResponse, Heartbeat, SummaryResponse
from .store import DuplicateDeviceError, Store, UnknownDeviceError

router = APIRouter()


def get_store(request: Request) -> Store:
    return request.app.state.store


@router.post("/devices", response_model=DeviceResponse, status_code=201)
def register_device(payload: DeviceRegistration, store: Store = Depends(get_store)) -> dict:
    """Register a new device. Returns 409 if the id already exists."""
    return store.register(payload.id, payload.name)


@router.post("/devices/{device_id}/heartbeat", response_model=DeviceResponse)
def send_heartbeat(device_id: str, heartbeat: Heartbeat, store: Store = Depends(get_store)) -> dict:
    """Record a heartbeat for a registered device. Returns 404 if unknown."""
    return store.record_heartbeat(device_id, heartbeat)


@router.get("/devices", response_model=list[DeviceResponse])
def list_devices(
    status: Optional[str] = Query(default=None, pattern="^(ONLINE|OFFLINE)$"),
    store: Store = Depends(get_store),
) -> list[dict]:
    """List all devices, optionally filtered by computed status."""
    return store.list_devices(status)


@router.get("/devices/{device_id}", response_model=DeviceResponse)
def get_device(device_id: str, store: Store = Depends(get_store)) -> dict:
    device = store.get(device_id)
    if device is None:
        raise UnknownDeviceError(f"unknown device '{device_id}'")
    return device


@router.get("/summary", response_model=SummaryResponse)
def fleet_summary(store: Store = Depends(get_store)) -> dict:
    return store.summary()


@router.get("/health")
def health() -> dict:
    return {"status": "ok"}


def create_app(store: Optional[Store] = None, config: Optional[Config] = None) -> FastAPI:
    """App factory. Tests inject their own Store (with a fake clock)."""
    config = config or Config.from_env()
    store = store or Store(heartbeat_timeout_seconds=config.heartbeat_timeout_seconds)

    app = FastAPI(
        title="Mini Device Fleet Monitor",
        description="Tracks heartbeats from a fleet of simulated devices.",
        version="1.0.0",
    )
    app.state.store = store
    app.state.config = config
    app.include_router(router)

    @app.exception_handler(DuplicateDeviceError)
    async def _duplicate(_: Request, exc: DuplicateDeviceError) -> JSONResponse:
        return JSONResponse(status_code=409, content={"detail": str(exc)})

    @app.exception_handler(UnknownDeviceError)
    async def _unknown(_: Request, exc: UnknownDeviceError) -> JSONResponse:
        return JSONResponse(status_code=404, content={"detail": str(exc)})

    return app


app = create_app()
