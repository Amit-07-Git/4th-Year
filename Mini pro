    store = make_store(clock)
    store.register("d1", None)
    store.record_heartbeat("d1", Heartbeat(status="OK"))
    clock.advance(61)
    assert store.get("d1")["status"] == "OFFLINE"
    store.record_heartbeat("d1", Heartbeat(status="OK"))
    assert store.get("d1")["status"] == "ONLINE"


def test_summary_counts_statuses(clock):
    store = make_store(clock)
    for i in range(1, 6):
        store.register(f"device-{i:02d}", None)
    for i in (1, 2, 3):
        store.record_heartbeat(f"device-{i:02d}", Heartbeat(status="OK"))
    assert store.summary() == {"total": 5, "online": 3, "offline": 2}
    clock.advance(31)
    assert store.summary() == {"total": 5, "online": 0, "offline": 5}


def test_list_devices_filters_by_status(clock):
    store = make_store(clock)
    store.register("a", None)
    store.register("b", None)
    store.record_heartbeat("a", Heartbeat(status="OK"))
    assert [d["id"] for d in store.list_devices("ONLINE")] == ["a"]
    assert [d["id"] for d in store.list_devices("OFFLINE")] == ["b"]
    assert len(store.list_devices()) == 2


def test_concurrent_heartbeats_are_counted_correctly():
    # Real clock: hammer the store from many threads to check the lock works.
    store = Store(heartbeat_timeout_seconds=30)
    store.register("d1", None)
    per_thread, threads = 200, []

    def worker():
        for _ in range(per_thread):
            store.record_heartbeat("d1", Heartbeat(status="OK"))

    for _ in range(8):
        threads.append(threading.Thread(target=worker))
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    assert store.get("d1")["heartbeat_count"] == 8 * per_thread
