    # -- read operations ---------------------------------------------------

    def get(self, device_id: str) -> Optional[dict]:
        with self._lock:
            record = self._devices.get(device_id)
            return self._snapshot(record) if record else None

    def list_devices(self, status: Optional[str] = None) -> List[dict]:
        with self._lock:
            snapshots = [self._snapshot(r) for r in self._devices.values()]
        if status:
            snapshots = [s for s in snapshots if s["status"] == status]
        return sorted(snapshots, key=lambda s: s["id"])

    def summary(self) -> dict:
        with self._lock:
            statuses = [self._status(r) for r in self._devices.values()]
        online = statuses.count(STATUS_ONLINE)
        return {"total": len(statuses), "online": online, "offline": len(statuses) - online}

    # -- internals -----------------------------------------------------------

    def _status(self, record: DeviceRecord) -> str:
        """ONLINE if a heartbeat was received within the timeout window.

        A device that has never sent a heartbeat is OFFLINE. The boundary is
        inclusive: exactly `timeout` seconds since the last heartbeat is still
        ONLINE; anything more is OFFLINE.
        """
        if record.last_seen_at is None:
            return STATUS_OFFLINE
        elapsed = (self._clock() - record.last_seen_at).total_seconds()
        return STATUS_ONLINE if elapsed <= self.heartbeat_timeout_seconds else STATUS_OFFLINE

    def _snapshot(self, record: DeviceRecord) -> dict:
        now = self._clock()
        seconds_since = (
            round((now - record.last_seen_at).total_seconds(), 3)
            if record.last_seen_at is not None
            else None
        )
        return {
            "id": record.id,
            "name": record.name,
            "status": self._status(record),
            "last_heartbeat": iso_z(record.last_client_timestamp) if record.last_client_timestamp else None,
            "last_seen": iso_z(record.last_seen_at) if record.last_seen_at else None,
            "seconds_since_last_heartbeat": seconds_since,
            "heartbeat_count": record.heartbeat_count,
            "last_reported_status": record.last_reported_status,
            "last_cpu_usage": record.last_cpu_usage,
            "last_signal_strength": record.last_signal_strength,
