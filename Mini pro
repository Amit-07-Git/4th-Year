def test_device_goes_offline_after_30s_timeout_and_recovers(client, clock):
    """End-to-end check of the core timeout requirement (fake clock)."""
    client.post("/devices", json={"id": "device-01", "name": "x"})
    client.post("/devices/device-01/heartbeat", json={"status": "OK"})
