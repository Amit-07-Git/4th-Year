jsx

function useFleet(pollMs = 5000) {
  const [devices, setDevices] = useState([]);
  const [summary, setSummary] = useState(null);

  useEffect(() => {
    const refresh = async () => {
      const [d, s] = await Promise.all([
        fetch("http://127.0.0.1:8000/devices").then(r => r.json()),
        fetch("http://127.0.0.1:8000/summary").then(r => r.json()),
      ]);
      setDevices(d); setSummary(s);
    };
    refresh();
    const id = setInterval(refresh, pollMs);
    return () => clearInterval(id);       // cleanup, like a good citizen
  }, [pollMs]);

  return { devices, summary };
}
That's literally your refresh() + setInterval(refresh, 5000) from the HTML file, expressed as React state. If after the assignment you want the full Vite + React setup as a separate frontend/ folder (kept out of the graded submission's critical path), I'll guide it step by step — first check node --version in a terminal and tell me what it says.

